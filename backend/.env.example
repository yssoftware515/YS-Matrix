# ============================================================
# YS-MATRIX ERP — Backend Environment Variables
# NEVER commit real values to Git.
# Copy to .env and fill in your actual values.
#
# DEPLOYMENT TARGET (declared): Vercel (serverless functions) +
# Neon (managed Postgres). See the NEON/Vercel note under DATABASE.
#
# NOTE FOR TESTS: this file doubles as the "production surface"
# for src/config/env.js fail-closed stripping — every key declared
# here is REMOVED from test processes unless it is ALSO declared in
# backend/.env.test with an approved test value. So: never add a
# runtime-critical-in-tests key here without approving a test value
# in .env.test. Keys that fall back to a safe default when absent
# (rate limits, cache, logging) are deliberately NOT approved in
# .env.test — tests exercise the defaults, not tuned overrides.
# ============================================================

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
# Local:        postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# Neon (Vercel): use the POOLED connection string (the "-pooler"
#   public host) so serverless function instances share a pool, e.g.
#   postgresql://user:password@ep-xxx-aaa-pooler.region.aws.neon.tech/db?sslmode=require
# REQUIRED at boot (env validator + Prisma).
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ys_matrix_erp?schema=public"

# Optional (NOT currently wired into prisma/schema.prisma): a
# NON-pooled (direct) Neon connection for `prisma migrate deploy`.
# If you move DATABASE_URL to the pooled host, wire
# `directUrl = env("DIRECT_URL")` in the datasource block and point
# migrations at this direct URL — poolers and migrations don't mix.
# DIRECT_URL="postgresql://user:password@ep-xxx-aaa.region.aws.neon.tech/db?sslmode=require"

# ─────────────────────────────────────────
# JWT SECRETS
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Both are REQUIRED and MUST be at least 32 chars. The two secrets
# MUST be different values. The startup validator crashes the server
# on any placeholder/weak/duplicate value.
# ─────────────────────────────────────────
JWT_ACCESS_SECRET="replace_with_a_real_random_64_char_hex_secret"
JWT_REFRESH_SECRET="replace_with_a_different_real_random_64_char_hex_secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=5000
NODE_ENV="development" # set to "production" on the deployment host
API_VERSION="v1"

# Set automatically by Vercel on serverless deployments. The app
# reads it to skip in-process node-cron registration (scheduled
# notifications are triggered externally via /api/cron/* instead).
# Do not set this manually except when emulating Vercel.
# VERCEL="1"

# ─────────────────────────────────────────
# CRON — secret for /api/cron/* external trigger
# REQUIRED in production (env validator enforces 32-char strength;
# a forgeable trigger secret would let anyone fire scheduled jobs).
# ─────────────────────────────────────────
CRON_SECRET="replace_with_a_real_random_cron_secret_at_least_32_chars"

# ─────────────────────────────────────────
# CORS — comma-separated frontend URLs
# MUST NOT contain localhost in production (validator rejects it).
# ─────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000"

# Public base URL of the frontend (used to build reset-password
# links in emails). REQUIRED for password-reset links to work.
FRONTEND_URL="http://localhost:3000"

# ─────────────────────────────────────────
# EMAIL TRANSPORT (Resend)
#   resend (default) — real Resend API sends
#   console — simulated sends (logged, nothing leaves the process)
# ─────────────────────────────────────────
EMAIL_TRANSPORT="resend"
EMAIL_SIMULATE_FAILURE="false"
RESEND_API_KEY=""
# Sender identity — until a domain is verified on the Resend
# dashboard, only onboarding@resend.dev works as the sender.
# Leave commented (the fallback below is used). If you need a
# custom sender, ADD this line to your .env (not here):
#   RESEND_FROM_EMAIL="YS-MATRIX <onboarding@resend.dev>"

# ─────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────
BCRYPT_ROUNDS=12 # safe range 4–15 (validator enforces); 12 = default

# MFA encryption key (AES-256-GCM — TOTP secrets at rest).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY="replace_with_a_real_random_64_char_hex_key"

# Bank account string surfaced for manual subscription payments.
# Optional — omitted when unset.
# PAYMENT_BANK_ACCOUNT="IBAN ... (per deployment)"

# ─────────────────────────────────────────
# RATE LIMITS (express-rate-limit windows; tune only with full
# awareness of trade-offs — defaults are the production-tested ones)
# ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000 # 15 min global window
RATE_LIMIT_MAX=300          # global cap / window
RATE_LIMIT_AUTH_MAX=5       # login brute-force
RATE_LIMIT_REGISTER_MAX=3   # registration abuse
RATE_LIMIT_SENSITIVE_MAX=10 # sensitive ops (password change, etc.)
RATE_LIMIT_SUPERADMIN_MAX=30
RATE_LIMIT_FORGOT_MAX=3     # forgot-password anti-enumeration
RATE_LIMIT_MFA_VERIFY_MAX=5 # TOTP brute-force
RATE_LIMIT_REFRESH_MAX=30   # refresh-token replay window

# ─────────────────────────────────────────
# RESPONSE CACHE (in-memory analytics cache — see middleware)
# Optional; unset keeps the tested 60s TTL / 1000-entry cap.
# ─────────────────────────────────────────
# CACHE_TTL_MS=60000
# CACHE_MAX_ENTRIES=1000

# ─────────────────────────────────────────
# PRISMA — verbose query logging (dev only; perf hazard in prod)
# ─────────────────────────────────────────
# PRISMA_QUERY_LOGGING="true"

# System showroom ID (do not change after seed)
SYSTEM_SHOWROOM_ID="sh-sys"

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL="info"

# ─────────────────────────────────────────
# SUPER ADMIN (seed scripts only — not needed at app runtime)
# ─────────────────────────────────────────
SUPER_ADMIN_EMAIL="admin@matrix.com"
SUPER_ADMIN_PASSWORD="replace_with_a_strong_real_password"
SUPER_ADMIN_NAME="System Administrator"

# ─────────────────────────────────────────
# DEMO DATA (seed.demo only — not needed at app runtime)
# ─────────────────────────────────────────
DEMO_OWNER_PASSWORD="replace_with_a_strong_real_password"
DEMO_STAFF_PASSWORD="replace_with_a_strong_real_password"