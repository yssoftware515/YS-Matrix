# ============================================================
# YS-MATRIX ERP — Environment Variables Template
# Phase 2 Stage 1 — NEVER commit real values to Git
# Copy this file to .env and fill in your actual values
# ============================================================

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ys_matrix_erp?schema=public"

# ─────────────────────────────────────────
# JWT SECRETS
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# ─────────────────────────────────────────
JWT_ACCESS_SECRET="GENERATE_STRONG_64_CHAR_SECRET_HERE"
JWT_REFRESH_SECRET="GENERATE_ANOTHER_STRONG_64_CHAR_SECRET_HERE"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=5000
NODE_ENV="development"
API_VERSION="v1"

# ─────────────────────────────────────────
# CORS — comma-separated list
# ─────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000"
CRON_SECRET=""
RESEND_API_KEY=""
FRONTEND_URL=""

# ─────────────────────────────────────────
# EMAIL TRANSPORT (Phase 2 — F-01)
#   resend (default) — real Resend API sends. RESEND_API_KEY required
#     at send time; a missing key fails only the one email (logged),
#     never the server.
#   console — simulated sends (logged, nothing leaves the process).
#     Used by the test environment. With console, EMAIL_SIMULATE_FAILURE
#     =true makes the transport throw so callers' failure/audit paths
#     can be exercised deterministically.
# ─────────────────────────────────────────
EMAIL_TRANSPORT="resend"
EMAIL_SIMULATE_FAILURE="false"

# ─────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# System showroom ID (used by SuperAdmin — do not change after seed)
SYSTEM_SHOWROOM_ID="system-showroom-001"

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL="info"
# ─────────────────────────────────────────
# SUPER ADMIN (used in seed script)
# ─────────────────────────────────────────
SUPER_ADMIN_EMAIL="admin@matrix.com"
SUPER_ADMIN_PASSWORD="enter strong pass"
SUPER_ADMIN_NAME="Yahya Al-Sulami"