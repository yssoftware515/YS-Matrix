# ============================================================
# YS-MATRIX ERP — Backend Environment Variables
# NEVER commit real values to Git
# Copy to .env and fill in your actual values
# ============================================================

# ─────────────────────────────────────────
# DATABASE
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ys_matrix_erp?schema=public"

# ─────────────────────────────────────────
# JWT SECRETS
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# The two secrets MUST be different values.
# ─────────────────────────────────────────
JWT_ACCESS_SECRET="GENERATE_STRONG_64_CHAR_SECRET_HERE"
JWT_REFRESH_SECRET="GENERATE_ANOTHER_STRONG_64_CHAR_SECRET_HERE"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=5000
NODE_ENV="development"
API_VERSION="v1"

# ─────────────────────────────────────────
# CORS — comma-separated frontend URLs
# MUST NOT contain localhost in production
# ─────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000"

# ─────────────────────────────────────────
# CRON — secret for /api/cron/* trigger
# REQUIRED in production (env validator enforces 32-char strength)
# ─────────────────────────────────────────
CRON_SECRET=""

# ─────────────────────────────────────────
# EMAIL TRANSPORT
#   resend (default) — real Resend API sends
#   console — simulated sends (logged, nothing leaves the process)
# ─────────────────────────────────────────
EMAIL_TRANSPORT="resend"
EMAIL_SIMULATE_FAILURE="false"
RESEND_API_KEY=""
FRONTEND_URL=""

# ─────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# MFA encryption key (AES-256-GCM — TOTP secrets)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=""

# Per-endpoint rate limits (tune only with full awareness of trade-offs)
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_SENSITIVE_MAX=10
RATE_LIMIT_SUPERADMIN_MAX=30
RATE_LIMIT_FORGOT_MAX=3

# System showroom ID (do not change after seed)
SYSTEM_SHOWROOM_ID="system-showroom-001"

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL="info"

# ─────────────────────────────────────────
# SUPER ADMIN (seed scripts only — not needed at app runtime)
# ─────────────────────────────────────────
SUPER_ADMIN_EMAIL="admin@matrix.com"
SUPER_ADMIN_PASSWORD="enter strong pass"
SUPER_ADMIN_NAME="Yahya Al-Sulami"
