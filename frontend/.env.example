# ============================================================
# YS-MATRIX ERP — Frontend Environment Variables
# Copy to .env.local and fill in your actual values
# ============================================================

# Backend API base URL (required)
# For local dev: http://localhost:5000/api/v1
# For production: https://your-backend-domain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional — support email shown on the Settings page.
# Leave empty to hide the direct-contact line;
# the self-service guidance block always renders.
NEXT_PUBLIC_SUPPORT_EMAIL=
